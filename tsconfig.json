{
  "compilerOptions": {
    "emitDeclarationOnly": true,
    "declaration": true,
    "isolatedDeclarations": true,
    "declarationDir": "dist/types",
    "outDir": "dist",
    "rootDir": "src",
    "module": "ESNext",
    "moduleResolution": "bundler",
    "isolatedModules": true,
    // dom + dom.iterable for the Web Streams, CompressionStream, Blob and TextEncoder types the core
    // relies on; the core never touches document/window (enforced by scripts/check-purity.mjs).
    "lib": ["esnext", "dom", "dom.iterable"],
    "strict": true,
    "noUncheckedIndexedAccess": true,
    "noImplicitOverride": true,
    "skipLibCheck": true,
    "target": "ES2022",
    // The node entry imports the core by its package name so the build can keep it external (see src/node/index.ts).
    "paths": {
      "@jetstreamapp/simple-excel": ["./src/index.ts"]
    }
  },
  "include": ["src/**/*.ts"],
  "exclude": ["src/**/__tests__/**"]
}
