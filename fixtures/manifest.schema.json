{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "xlsx-engine fixture manifest",
  "type": "object",
  "required": ["fixtures"],
  "properties": {
    "$schema": { "type": "string" },
    "fixtures": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["id", "path", "generator", "provenance", "license", "tags", "generated"],
        "additionalProperties": false,
        "properties": {
          "id": { "type": "string", "pattern": "^[a-z0-9][a-z0-9-]*$" },
          "path": {
            "type": "string",
            "description": "Relative to fixtures/. Generated fixtures live under .generated/ and are never committed."
          },
          "bytes": { "type": "integer", "minimum": 0 },
          "sha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
          "generator": {
            "type": "object",
            "required": ["name"],
            "properties": { "name": { "type": "string" }, "version": { "type": "string" }, "os": { "type": "string" } }
          },
          "provenance": {
            "type": "string",
            "description": "url | copy-of:<repo path> | script:<file> | applescript:<file> | manual:<STEPS.md ref>"
          },
          "license": { "type": "string" },
          "tags": {
            "type": "array",
            "items": { "type": "string" },
            "description": "EC-* edge-case ids and generator:<name> / kind:<golden|edge|hostile|jetstream|corpus>"
          },
          "expected": {
            "type": ["string", "null"],
            "description": "expected/<id>.json cell dump, or null when no ground truth exists yet"
          },
          "expectedError": {
            "type": "string",
            "description": "For hostile fixtures: the error code a reader must raise (ENCRYPTED, NOT_XLSX, ZIP_BOMB, TRUNCATED, LIMIT_EXCEEDED, XML_DOCTYPE)"
          },
          "generated": { "type": "boolean" },
          "notes": { "type": "string" }
        }
      }
    }
  }
}
